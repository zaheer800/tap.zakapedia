VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_UPI_ID=yourname@upi

# AI — API key lives as a Supabase secret, NOT here (never exposed to the browser).
# Set it once with the Supabase CLI:
# supabase secrets set GOOGLE_AI_API_KEY=your-key-from-aistudio.google.com
# The edge function at supabase/functions/ai-generate/ handles all AI calls.
